# 练秋湖纯问数执行器：多展厅配置
# 本文件只包含展厅鉴权与回程配置；服务端口、模型、知识库等仍由 config.json 提供。
# 复制为 .env 后填写真实值。.env 已被 Git 忽略，禁止提交真实 Token。

# 必填。格式：token:exhibitionId[,token:exhibitionId...]
# 左侧入站 Token 与右侧展厅 ID 精确映射；同一个展厅可配置多个 Token 做轮换。
# Token：16-512 位高强度随机 secret；exhibitionId：1-64 位 [A-Za-z0-9_-]。
HC_TOKEN_MAP=example-token-a-0123456789abcdef:HC-A7K9P2,example-token-b-0123456789abcdef:HC-B4M8Q1

# 每个展厅必须提供完整的可信回程配置：
#   HC_HALL_<展厅ID大写、非字母数字转下划线>_AGENT
#   HC_HALL_<展厅>_INGRESS_HOST
#   HC_HALL_<展厅>_INGRESS_PORT
#   HC_HALL_<展厅>_INGRESS_TOKEN
#   HC_HALL_<展厅>_TO            （可选，仅在请求缺少 reply_to 时作为接收方兜底）
#
# 入站 Token 与回程 Token 是两种不同凭据。
# 回程地址由服务端固定为 http://<INGRESS_HOST>:<INGRESS_PORT>/agent/send。
# 请求 Body/context 中的 agent、exhibitionId、callback 都不能改变可信回程目标。
# 多展厅模式下缺少任一必需配置会启动失败，不会回退到其他展厅。
# 不同展厅的 AGENT 与 INGRESS_HOST:PORT 不得重复。
HC_HALL_HC_A7K9P2_AGENT=
HC_HALL_HC_A7K9P2_INGRESS_HOST=
HC_HALL_HC_A7K9P2_INGRESS_PORT=
HC_HALL_HC_A7K9P2_INGRESS_TOKEN=
# HC_HALL_HC_A7K9P2_TO=

HC_HALL_HC_B4M8Q1_AGENT=
HC_HALL_HC_B4M8Q1_INGRESS_HOST=
HC_HALL_HC_B4M8Q1_INGRESS_PORT=
HC_HALL_HC_B4M8Q1_INGRESS_TOKEN=
# HC_HALL_HC_B4M8Q1_TO=

# 第三个及更多展厅按同样规则追加，数量不写死。
# HC_HALL_HC_C6N3R5_AGENT=
# HC_HALL_HC_C6N3R5_INGRESS_HOST=
# HC_HALL_HC_C6N3R5_INGRESS_PORT=
# HC_HALL_HC_C6N3R5_INGRESS_TOKEN=
# HC_HALL_HC_C6N3R5_TO=

# 单展厅兼容回退：仅当 HC_TOKEN_MAP 只映射一个展厅时，
# 以下旧变量才作为该展厅缺失 HC_HALL_* 时的兜底值。多展厅模式忽略。
# AGENT=
# INGRESS_HOST=
# INGRESS_PORT=
# INGRESS_TOKEN=
