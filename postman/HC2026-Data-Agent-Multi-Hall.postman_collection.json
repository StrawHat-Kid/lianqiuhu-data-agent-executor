        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"context\": {\n    \"agent\": \"context-agent\",\n    \"reply_to\": \"user@example.com\",\n    \"groupchat\": false,\n    \"callback\": \"{{dataCallbackB}}\"\n  },\n  \"commands\": [\n    {\n      \"action\": \"AI问答会话重置\",\n      \"params\": {}\n    }\n  ]\n}",
