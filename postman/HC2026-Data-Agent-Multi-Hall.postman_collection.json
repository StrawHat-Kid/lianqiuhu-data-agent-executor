        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"exhibitionId\": \"{{exhibitionIdA}}\",\n  \"context\": {\n    \"exhibitionId\": \"{{exhibitionIdA}}\",\n    \"agent\": \"spoofed-agent\",\n    \"reply_to\": \"user@example.com\",\n    \"groupchat\": false,\n    \"callback\": \"{{dataCallbackB}}\"\n  },\n  \"commands\": [\n    {\n      \"action\": \"AI问答会话重置\",\n      \"params\": {}\n    }\n  ]\n}",
