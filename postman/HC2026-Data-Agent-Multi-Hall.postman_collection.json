    {
      "name": "05 A 展厅 AI 智能问答",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-HC-Token",
            "value": "{{tokenA}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"context\": {\n    \"agent\": \"context-agent\",\n    \"reply_to\": \"user@example.com\",\n    \"groupchat\": false,\n    \"callback\": \"{{dataCallbackA}}\"\n  },\n  \"commands\": [\n    {\n      \"action\": \"AI智能问答\",\n      \"params\": {\n        \"问题\": \"园区有多少建筑\"\n      }\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/commands",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "commands"
          ]
        },
        "description": "验证原有纯问数业务与回程正文格式不变。"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('ok=true', () => pm.expect(pm.response.json().ok).to.eql(true));",
              "pm.test('reply present', () => pm.expect(pm.response.json().reply).to.be.a('string').and.not.empty);"
            ]
          }
        }
      ]
    },
    {
      "name": "06 缺少 Token（预期 401）",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"context\": {\n    \"agent\": \"context-agent\",\n    \"reply_to\": \"user@example.com\",\n    \"groupchat\": false,\n    \"callback\": \"{{dataCallbackA}}\"\n  },\n  \"commands\": [\n    {\n      \"action\": \"AI问答会话重置\",\n      \"params\": {}\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/commands",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "commands"
          ]
        },
        "description": "未携带 X-HC-Token，必须 401，且不回调。"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));",
              "pm.test('unauthorized', () => pm.expect(pm.response.json()).to.eql({ ok: false, error: 'unauthorized' }));"
            ]
          }
        }
      ]
    },
