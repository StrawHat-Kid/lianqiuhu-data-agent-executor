        },
        "description": "预期 200，实际回程仍使用 B 展厅 Agent 与 Token；Body/context 不能覆盖鉴权结果。"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
