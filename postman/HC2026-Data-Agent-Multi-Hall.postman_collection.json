{
  "info": {
    "name": "HC2026 Data Agent Multi-Hall",
    "description": "纯问数执行器多展厅鉴权、按展厅回程配置与隔离验证。真实 Token 只填写在本地环境，禁止提交。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 健康检查（匿名）",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        },
        "description": "无需 Token。"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('ok=true', () => pm.expect(pm.response.json().ok).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 A 展厅会话重置（验证回程 Agent/Host/Port/Token）",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-HC-Token",
            "value": "{{tokenA}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"context\": {\n    \"agent\": \"context-agent\",\n    \"reply_to\": \"user@example.com\",\n    \"groupchat\": false,\n    \"callback\": \"{{dataCallbackA}}\"\n  },\n  \"commands\": [\n    {\n      \"action\": \"AI问答会话重置\",\n      \"params\": {}\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/commands",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "commands"
          ]
        },
        "description": "A Token 必须映射到 HC-A7K9P2，回程使用 A 展厅 AGENT、INGRESS_HOST、INGRESS_PORT、INGRESS_TOKEN。"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('ok=true', () => pm.expect(pm.response.json().ok).to.eql(true));"
            ]
          }
        }
      ]
    },
